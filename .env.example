# Environment Configuration Example
# Copy to .env for local deployment

NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL 16 with PostGIS 3.4)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fleet_delivery_db

# Redis Caching & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & JWT Secrets
JWT_SECRET=fleet-management-jwt-super-secret-key-2026
JWT_REFRESH_SECRET=fleet-refresh-super-secret-key-2026

# Seed SuperAdmin Account
ADMIN_EMAIL=admin@fleetplatform.com
ADMIN_PASSWORD=Admin@12345

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=fleet_admin
MINIO_ROOT_PASSWORD=fleet_minio_secret
S3_BUCKET_NAME=fleet-pod-assets

# Map Provider (openstreetmap or google)
MAP_PROVIDER=openstreetmap
GOOGLE_MAPS_API_KEY=

# Testing Flags
ALLOW_MOCK_LOCATION=false
